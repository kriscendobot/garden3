board:
  claim_ttl_seconds: 14400
  clock_tolerance_seconds: 300
  expiry_grace_seconds: 600
budget:
  planning_ceiling: 0.9
  reservation_tokens: 2000000
capabilities:
  base:
    - "node"
    - "rust"
dev_publish:
  key: "npm-minion-town"
  ref: "llm"
  registry: "https://npm.minion.town"
  repository: "endojs/endo-but-for-bots"
  work: "/var/tmp/garden-dev-publish"
github:
  bot: "kriscendobot"
  identity:
    email: "279080640+kriscendobot@users.noreply.github.com"
    name: "Kriscendo Bot"
  overlap_seconds: 120
  poll_seconds: 90
  repo: "kriscendobot/garden3"
  watch:
    - issues: true
      repo: "kriscendobot/garden3"
    - issues: true
      repo: "kriscendobot/garden"
    - poll_seconds: 300
      repo: "endojs/endo-but-for-bots"
    - poll_seconds: 300
      repo: "kriscendobot/cosgov"
    - poll_seconds: 300
      repo: "kriscendobot/endo"
    - poll_seconds: 300
      repo: "kriscendobot/endo-but-for-bots"
    - poll_seconds: 300
      repo: "kriscendobot/finbot"
    - poll_seconds: 300
      repo: "kriscendobot/garden-book"
    - poll_seconds: 300
      repo: "kriscendobot/list"
    - poll_seconds: 300
      repo: "kriscendobot/minion.town"
    - poll_seconds: 300
      repo: "kriscendobot/moddable"
    - poll_seconds: 300
      repo: "kriscendobot/ocapn"
    - poll_seconds: 300
      repo: "kriscendobot/oros-ckm-data-readiness"
    - poll_seconds: 300
      repo: "kriscendobot/proposal-compartments"
    - poll_seconds: 300
      repo: "kriscendobot/test262"
    - poll_seconds: 300
      repo: "kriscendobot/vattr97"
    - poll_seconds: 300
      repo: "kriscendobot/ymax-e2e"
    - poll_seconds: 300
      repo: "kriscendobot/ymax-stdio-mcp"
handoff:
  review_from: 2
plots:
  - "alder"
  - "birch"
  - "cedar"
  - "dogwood"
  - "elm"
  - "fir"
  - "ginkgo"
  - "hazel"
  - "holly"
  - "juniper"
  - "katsura"
  - "larch"
  - "maple"
  - "oak"
  - "pine"
  - "quince"
  - "rowan"
  - "spruce"
  - "willow"
  - "yew"
quiescence:
  ack_timeout_seconds: 3600
  archive_ref_prefix: "refs/archive"
  archive_retention_months: 2
  cadence_days: 7
  journal_retention_months: 6
slots:
  count: 4
  uid_base: 2000
upstream:
  garden:
    commit: "0dda301cbeb484d69447f7c60214788924464f8c"
    ref: "main2"
    url: "https://github.com/kriscendobot/garden.git"
worker:
  kill_after_seconds: 30
  window_seconds: 2400
