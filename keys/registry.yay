keys:
  anthropic-worker:
    consumer: "worker"
    purpose: "The model credential a worker's harness uses. Given to the harness through its key helper, never its environment."
  claude-login:
    consumer: "steward"
    file: "steward/.claude/.credentials.json"
    lend: "access-only"
    lend_as: ".claude/.credentials.json"
    provider: "claude"
    purpose: "The operator's Claude subscription login, made by logging in in the session ./garden opens. Its one home is the steward's Claude config; a job is lent only its access token, written into its home at setup, never the refresh token, so no job can rotate the login."
  github-bot:
    consumer: "steward"
    file: "steward/.config/gh/hosts.yml"
    provider: "gh"
    purpose: "The bot account's GitHub token. It lives in one place, gh's own store, written when the operator logs the bot in by hand (gh auth login, in ./garden sh); the steward reads it from gh at each call. No job ever holds it."
  github-ssh:
    consumer: "steward"
    file: "steward/.ssh/id_ed25519"
    purpose: "The bot account's ssh key, for publishing by git. Generated inside the box by gh at the bot's login, and it never leaves the box; its public half is on the bot's GitHub account."
  npm-minion-town:
    consumer: "steward"
    purpose: "A PublishGrant token for npm.minion.town, issued by the registry operator (npm-registry-admin grants issue) for @endo/* and ses. It allows only dev-* prereleases. Set with garden keys set npm-minion-town, from a pipe. It reaches npm in a 0600 .npmrc that exists only while garden devpublish publish runs."
