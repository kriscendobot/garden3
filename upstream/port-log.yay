entries:
  - commit: "f0ba25822b06d7c195b7f224ae8f76df1e3f96ff"
    disposition: "vendor"
    note: "Unchanged. Apache-2.0."
    path: "vendor/libyay/yay.js"
    source: "yay"
    source_path: "js/libyay/yay.js"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "ensure_clone, sync_clone, commit_and_push, retry_land."
    path: "src/shard.js"
    source: "tower"
    source_path: "scripts/jobs/common.sh"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "port"
    note: "Shallow clones of the journal (GARDEN_JOURNAL_SEED_DEPTH); the jittered backoff."
    path: "src/shard.js"
    source: "garden"
    source_path: "scripts/jobs/common.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "Orphan branches from seed directories, worktrees at the root."
    path: "scripts/shards/bootstrap.sh"
    source: "tower"
    source_path: "scripts/tower/bootstrap-branches.sh"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "port"
    note: "The accepted push is the claim; move on after a lost race; requires and host= gating. Also post-job.sh, complete-job.sh, reaper.sh."
    path: "src/board.js"
    source: "garden"
    source_path: "scripts/jobs/claim-job.sh"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "synthesize"
    note: "The derived rank (1 + max child) behind omega levels; the cap, the role classes and the foreman are not carried."
    path: "src/board.js"
    source: "garden"
    source_path: "scripts/jobs/cnf-backlog-triple.py"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The atomicity rule for an operation that spans two branches."
    path: "src/boardService.js"
    source: "tower"
    source_path: "divergence/branch-routing.md"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "port"
    note: "The weekly slate, the planning ceiling, maintainer authorization. Also arc-spend.sh and usage-meter.sh (billable tokens)."
    path: "src/budget.js"
    source: "garden"
    source_path: "scripts/jobs/set-apportionment.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The PostToolUse hook and the two leads. Also handlers/prompt.sh (the clock paragraph)."
    path: "src/wrapup.js"
    source: "tower"
    source_path: "scripts/jobs/handlers/deadline-hook.sh"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "port"
    note: "The first lead (a quarter of the window, capped at 15 minutes) and the wording."
    path: "src/wrapup.js"
    source: "garden"
    source_path: "scripts/jobs/deadline-nudge.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "Keys as 0600 files; also worker-auth.py (the stripped environment) and scripts/typesafe/common.sh (refuse a loose mode)."
    path: "src/keys.js"
    source: "tower"
    source_path: "scripts/jobs/set-api-key.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The wall. Also cut.sh, genome-paths, land.sh."
    path: "src/plots.js"
    source: "tower"
    source_path: "scripts/vestibule/pre-receive"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The form of the list, not its entries."
    path: "plots/genome-paths"
    source: "tower"
    source_path: "scripts/vestibule/genome-paths"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "repositories/<org>-<name>.git and one checkout per job per project; the wip save from scripts/jobs/wip.sh."
    path: "src/slots.js"
    source: "tower"
    source_path: "WORKTREES.md"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "synthesize"
    note: "The valve (the maintainer sees what crosses) and the file names found on disk on both sides. No mail content was read."
    path: "src/mail.js"
    source: "tower"
    source_path: "designs/garden-protocol.md"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "synthesize"
    note: "Drain as a moratorium on claims; a follower fast-forwarding to a released commit (self-deploy.sh). Truncation is new."
    path: "src/quiescence.js"
    source: "garden"
    source_path: "scripts/jobs/drain-fleet.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "Fast-forward only; refuse a dirty or diverged checkout."
    path: "src/host.js"
    source: "tower"
    source_path: "scripts/jobs/refresh-root.sh"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "synthesize"
    note: "A closed vocabulary of host operations, replaced by desired state on a branch."
    path: "src/clients.js"
    source: "garden"
    source_path: "scripts/jobs/sysop.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The launcher: instance name, build contract label, adopt and promote."
    path: "garden"
    source: "tower"
    source_path: "tower"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "synthesize"
    note: "Preflight before the main process; accounts. No systemd, no key handoff."
    path: "entrypoint.sh"
    source: "tower"
    source_path: "entrypoint.sh"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The BuildKit and RootlessKit versions and sha256 pins."
    path: "capabilities/buildkit/capability.yay"
    source: "tower"
    source_path: "Dockerfile"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "synthesize"
    note: "The form of the wizard: the host-access boundary first, decisions the operator makes, batched operator commands, resumable steps."
    path: "scripts/shards/seed/main/SETUP.md"
    source: "tower"
    source_path: "starter-kit/SETUP.md"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "port"
    note: "The porting procedure and the port log."
    path: "designs/upstream.md"
    source: "tower"
    source_path: "DIVERGENCE.md"
  - commit: "72a1ff40fee9d425dfcb6e8bd8ad715cbe51285c"
    disposition: "synthesize"
    note: "The document and its conventions."
    path: "WORKTREES.md"
    source: "tower"
    source_path: "WORKTREES.md"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "port"
    note: "The garden's own issue watcher: allowlist-only gate before any text, the address gate, eyes, closed issues, noting a stranger once. Also handlers/issue-source-gh.sh (the two list calls)."
    path: "src/watcher.js"
    source: "garden"
    source_path: "scripts/jobs/issue-inbox-watcher.sh"
  - commit: "c2a2b3c899aa9770491212d2a60107f64404f38d"
    disposition: "synthesize"
    note: "Replies and reactions as the bot, with a provenance footer; the once-only marker is new."
    path: "src/steward.js"
    source: "garden"
    source_path: "scripts/jobs/handlers/comment-reply-gh.sh"
sources:
  garden: "the prior garden, github.com/kriscendobot/garden (see ANCESTRY.md)"
  tower: "the tower, private"
  yay: "github.com/kriskowal/yay"
