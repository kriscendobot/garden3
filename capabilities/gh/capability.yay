bin:
  - "bin/gh"
name: "gh"
requires: []
sources:
  amd64:
    - sha256: null
      strip: 1
      url: "https://github.com/cli/cli/releases/download/v2.62.0/gh_2.62.0_linux_amd64.tar.gz"
  arm64:
    - sha256: null
      strip: 1
      url: "https://github.com/cli/cli/releases/download/v2.62.0/gh_2.62.0_linux_arm64.tar.gz"
summary: "The GitHub CLI. Only the steward runs it, with the bot's token read from a key file; jobs do not receive the token."
verify:
  - expect: "gh version 2\\.62\\.0"
    run:
      - "gh"
      - "--version"
version: "2.62.0"
