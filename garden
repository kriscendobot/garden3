#!/bin/sh
# garden — the launcher. Runs on a host, outside the box, as the maintainer.
#
# Usage: ./garden [claude [args...] | up | sh | logs | stop | status | build | check | adopt <archive> | promote <digest12> | reset]
#
# Shell, because it runs before any runtime exists and only arranges for one
# (designs/services.md). The box is one container: this checkout mounted at
# its own path, a volume for capabilities, no key in its environment (designs/keys.md).
#
# Ported in shape from the tower's `tower` launcher: the instance name, the
# build contract label, and adopt/promote for a successor image built inside
# the box. Unlike the tower's, the build contract is the Dockerfile alone,
# because the image copies nothing in.
set -eu
HERE="$(cd "$(dirname "$0")" && pwd -P)"
id8="$(printf '%s' "$HERE" | sha256sum | cut -c1-8)"
NAME="$(hostname -s)-$(basename "$HERE")-$id8"
IMAGE="garden-base"
LABEL="garden.build-contract-sha"
contract() { sha256sum "$HERE/Dockerfile" | cut -d' ' -f1; }
label_of() { docker image inspect --format "{{ index .Config.Labels \"$LABEL\" }}" "$1" 2>/dev/null || true; }
die() { echo "garden: $*" >&2; exit 1; }

# Host-local settings, for a host whose Docker needs them (ignored by git):
#   GARDEN_BUILD_NETWORK  the network `docker build` uses (default: Docker's)
#   GARDEN_NETWORK        the network the box runs on (default: Docker's bridge)
#   GARDEN_DNS            a resolver for the box, if the network's own does not answer
[ -f "$HERE/.garden-launcher" ] && . "$HERE/.garden-launcher"
net_args() {
  if [ "$1" = build ]; then [ -n "${GARDEN_BUILD_NETWORK:-}" ] && printf -- '--network %s ' "$GARDEN_BUILD_NETWORK"
  else
    [ -n "${GARDEN_NETWORK:-}" ] && printf -- '--network %s ' "$GARDEN_NETWORK"
    [ -n "${GARDEN_DNS:-}" ] && printf -- '--dns %s ' "$GARDEN_DNS"
  fi
  true
}
# shellcheck disable=SC2046
build() { docker build $(net_args build) --label "$LABEL=$(contract)" -t "$IMAGE" -f "$HERE/Dockerfile" "$HERE"; }
create() {
  docker image inspect "$IMAGE" >/dev/null 2>&1 || build
  # The checkout is mounted at its own path, as the tower does, so that a
  # worktree's pointer to its repository resolves inside the box too. When the
  # checkout is a worktree of a bare repository beside it (the wizard's
  # layout), that repository is mounted as well.
  common="$(git -C "$HERE" rev-parse --path-format=absolute --git-common-dir)"
  case "$common" in "$HERE"/*) common_mount="" ;; *) common_mount="-v $common:$common" ;; esac
  # No -e for any key. --init gives the box a reaping PID 1 without baking one in.
  # shellcheck disable=SC2046
  docker run -d --name "$NAME" --hostname "$NAME" --init $(net_args run) \
    --cap-drop ALL --cap-add CHOWN --cap-add DAC_OVERRIDE --cap-add FOWNER --cap-add KILL \
    --cap-add SETUID --cap-add SETGID --security-opt no-new-privileges=false \
    --tmpfs /tmp --tmpfs /run \
    -e GARDEN_ROOT="$HERE" -e GARDEN_HOST="$NAME" -e GARDEN_SLOT_COUNT="${GARDEN_SLOT_COUNT:-4}" \
    -v "$HERE:$HERE" $common_mount -v "garden-cap-$id8:/opt/garden/cap" \
    "$IMAGE" supervise
}
check() {
  have="$(label_of "$IMAGE")"; want="$(contract)"
  [ "$have" = "$want" ] && echo "image matches the Dockerfile ($want)" || { echo "image is stale: built from ${have:-nothing}, the Dockerfile is $want"; return 1; }
}

up() { docker container inspect "$NAME" >/dev/null 2>&1 && docker start "$NAME" >/dev/null || create; }
# Wait until the entrypoint has written garden-env: on a first boot that is
# after the runtime is fetched and the warden built.
ready() {
  i=0
  until docker exec "$NAME" test -x /usr/local/bin/garden-env 2>/dev/null; do
    i=$((i + 1)); [ "$i" -le 150 ] || die "the box did not come up; see ./garden logs"
    [ "$i" != 1 ] || echo "garden: waiting for the box (a first boot takes about a minute)" >&2
    sleep 2
  done
}

case "${1:-claude}" in
  # The default: bring the box up and open a Claude Code session in the shed,
  # as the steward. The harness is a capability this host installs when it is
  # first wanted (a no-op afterwards), pinned, so it does not update itself.
  # Its login is the operator's, made in the session, and is kept under the
  # steward's home in the state directory like the bot's (designs/keys.md).
  claude)
    [ $# -eq 0 ] || shift
    up; ready
    docker exec -u steward "$NAME" /usr/local/bin/garden-env garden capabilities install claude-code >/dev/null \
      || die "the claude-code capability did not install"
    docker exec -it -u steward -e TERM="${TERM:-xterm-256color}" -e DISABLE_AUTOUPDATER=1 "$NAME" /usr/local/bin/garden-env claude "$@"
    ;;
  up) up ;;
  # Enter the running box as the steward, with the garden's environment. The
  # entrypoint is not run again: it wrote garden-env once, at boot.
  # The shell it opens is already set up for the bot's login: gh, git and ssh
  # are on PATH and keep everything under the steward's home in the state
  # directory (SETUP.md, step 8).
  sh) docker exec -it -u steward -e TERM="${TERM:-xterm-256color}" "$NAME" /usr/local/bin/garden-env /bin/bash ;;
  logs) docker logs --tail "${2:-50}" "$NAME" ;;
  stop) docker stop "$NAME" ;;
  status) docker ps --filter "name=$NAME" --format '{{.Names}} {{.Status}}'; check || true ;;
  build) build ;;
  check) check ;;
  reset) docker rm -f "$NAME" >/dev/null 2>&1 || true; create ;;
  adopt)
    # Take a successor image built inside the box: <digest12>.docker.tar with
    # <digest12>.yay beside it. Every check must pass before it is loaded.
    tarball="${2:?usage: garden adopt <archive.docker.tar>}"; manifest="${tarball%.docker.tar}.yay"
    [ -f "$tarball" ] && [ -f "$manifest" ] || die "need the archive and its manifest"
    field() { sed -n "s/^$1: \"\\(.*\\)\"\$/\\1/p" "$manifest"; }
    want="$(contract)"
    [ "$(field contract)" = "$want" ] || die "the archive was built from another Dockerfile than this checkout's"
    [ "$(field archive_sha256)" = "$(sha256sum "$tarball" | cut -d' ' -f1)" ] || die "the archive does not match its manifest"
    d12="$(printf '%s' "$want" | cut -c1-12)"
    tar -xOf "$tarball" manifest.json | grep -q "\"RepoTags\":\\[\"garden-successor:$d12\"\\]" || die "the archive's tag is not garden-successor:$d12"
    docker load -i "$tarball" >/dev/null
    [ "$(label_of "garden-successor:$d12")" = "$want" ] || { docker image rm "garden-successor:$d12" >/dev/null; die "the loaded image's label is wrong"; }
    # Smoke: no network, no key, a throwaway root. The base system must offer what the entrypoint needs.
    docker run --rm --network none --entrypoint /bin/sh "garden-successor:$d12" -c \
      'command -v git curl xz sha256sum tar useradd setpriv ssh ssh-keygen >/dev/null && test -u /usr/bin/newuidmap && git --version' >/dev/null \
      || { docker image rm "garden-successor:$d12" >/dev/null; die "the successor failed its smoke test"; }
    docker tag "garden-successor:$d12" "garden-adopted:$d12"
    echo "adopted garden-adopted:$d12; promote it during a quiescence with: ./garden promote $d12"
    ;;
  promote)
    d12="${2:?usage: garden promote <digest12>}"
    docker image inspect "garden-adopted:$d12" >/dev/null 2>&1 || die "no adopted image $d12"
    [ "$(label_of "garden-adopted:$d12")" = "$(contract)" ] || die "the adopted image no longer matches this checkout's Dockerfile"
    docker image inspect "$IMAGE" >/dev/null 2>&1 && docker tag "$IMAGE" "$IMAGE-previous"
    docker tag "garden-adopted:$d12" "$IMAGE"
    echo "promoted. ./garden reset recreates the box on it; roll back with: docker tag $IMAGE-previous $IMAGE && ./garden reset"
    ;;
  *) die "usage: ./garden [claude [args...]|up|sh|logs|stop|status|build|check|adopt <archive>|promote <digest12>|reset]" ;;
esac
